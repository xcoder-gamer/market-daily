# Copy to .env for local runs (python-dotenv is NOT needed: just export these, or use your shell's env loader).
# NEVER commit the real .env. In GitHub, the secrets below go in Settings > Secrets and variables > Actions.

# --- secrets ---
UPSTOX_ACCESS_TOKEN=
ANTHROPIC_API_KEY=
# only if ENABLE_VIDEO=1
ELEVENLABS_API_KEY=

# --- plain settings (GitHub: "Variables" tab) ---
ANTHROPIC_MODEL=claude-sonnet-5-5
SITE_URL=https://your-domain.example      # no trailing slash
SITE_BASE_PATH=                            # empty for a custom domain; /repo-name for username.github.io/repo-name
SITE_NAME=Market Daily
SITE_AUTHOR=Your Name
CONTACT_EMAIL=you@example.com
UPSTOX_HIST_VERSION=v2                     # or v3
ENABLE_VIDEO=0                             # 1 = ElevenLabs voiceover + ffmpeg video (optional)
ELEVENLABS_VOICE_ID_EN=
ELEVENLABS_VOICE_ID_HI=
